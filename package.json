        "@types/react-dom": "^19.3.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.3.0",
        "@webext-core/fake-browser": "^2.0.1",
        "chrome-webstore-upload": "^6.0.1",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
